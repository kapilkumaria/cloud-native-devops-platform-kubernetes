        </mxCell>

        <mxCell id="stack" value="&lt;b&gt;Technology Stack&lt;/b&gt;&lt;br&gt;☸️ Kubernetes | 🦑 ArgoCD | 🚦 Traefik | 🔥 Prometheus | 📊 Grafana | 🔔 Alertmanager | 🟧 Loki | 🦝 Promtail | 🟧 AWS EKS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=16;shadow=1;align=center;" vertex="1" parent="1">
