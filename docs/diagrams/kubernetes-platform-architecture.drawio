        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;━━ Request / Traffic Flow&lt;br&gt;┄┄ GitOps Sync&lt;br&gt;┄┄ Metrics Flow&lt;br&gt;┄┄ Logs Flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=14;shadow=1;align=left;spacingLeft=15;" vertex="1" parent="1">
